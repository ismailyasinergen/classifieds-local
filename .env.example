# Local development environment for classifieds_local.
# Copy to .env for local Docker Compose development.
#
# Production should use .env.production based on .env.production.example.

DJANGO_SECRET_KEY=dev-only-secret-key-change-later
DJANGO_DEBUG=1

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Local Compose applies pending migrations automatically at container startup.
DJANGO_AUTO_MIGRATE=1

DB_NAME=classifieds_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

POSTGRES_DB=classifieds_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
