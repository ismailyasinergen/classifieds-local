# Local development environment for classifieds_local.
# Copy to .env for local Docker Compose development.
#
# Production should use .env.production based on .env.production.example.

DJANGO_SECRET_KEY=dev-only-secret-key-change-later
DJANGO_DEBUG=1

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_LOG_LEVEL=INFO

# V333 observation is default-off and never emits an enforcement header.
DJANGO_CSP_REPORT_ONLY_ENABLED=0
DJANGO_CSP_REPORT_ONLY_REPORT_URI=

# Local Compose applies pending migrations automatically at container startup.
DJANGO_AUTO_MIGRATE=1

DB_NAME=classifieds_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

POSTGRES_DB=classifieds_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# V307 provider outcome ingestion remains unavailable until both values are set.
NOTIFICATION_PROVIDER_NAME=
NOTIFICATION_PROVIDER_WEBHOOK_SECRET=
NOTIFICATION_PROVIDER_WEBHOOK_MAX_AGE_SECONDS=300

# V308 retention defaults to dry-run-only operation.
# Backups are not selectively rewritten. After any restore, run the cleanup
# dry-run and a separately confirmed apply before production traffic resumes.
NOTIFICATION_DELIVERY_EVENT_RETENTION_DAYS=90
NOTIFICATION_DELIVERY_RETENTION_BACKUP_POLICY=restore_requires_recleanup
NOTIFICATION_DELIVERY_RETENTION_APPLY_ENABLED=0
NOTIFICATION_DELIVERY_RETENTION_DEFAULT_LIMIT=100
NOTIFICATION_DELIVERY_RUNTIME_ENFORCEMENT_ENABLED=0
