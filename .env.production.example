# Production environment example for classifieds_local.
#
# Copy this file to .env.production and replace every placeholder before using:
# docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Do not commit your real .env.production file.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-of-at-least-50-characters

# Comma-separated hostnames that may serve this site.
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Comma-separated HTTPS origins allowed for CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Enable these only when HTTPS is correctly configured at the proxy/load balancer.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1

# HSTS: enable only after confirming the domain is permanently served over HTTPS.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1

# Set to 1 only when you are ready for browser HSTS preload submission.
DJANGO_SECURE_HSTS_PRELOAD=0

DJANGO_LOG_LEVEL=INFO

# V333 CSP observation remains default-off until a deployment has an approved
# same-origin path or credential-free HTTPS report collector. This setting
# never enables CSP enforcement.
DJANGO_CSP_REPORT_ONLY_ENABLED=0
DJANGO_CSP_REPORT_ONLY_REPORT_URI=
DJANGO_CSP_REPORT_INGESTION_ENABLED=0
# Set each attestation to 1 only after the named external control or smoke
# evidence has been independently reviewed. They do not configure that control.
DJANGO_CSP_OBSERVATION_EDGE_RATE_LIMIT_APPROVED=0
DJANGO_CSP_OBSERVATION_LOG_GOVERNANCE_APPROVED=0
DJANGO_CSP_OBSERVATION_SYNTHETIC_REPORT_VERIFIED=0

# Production uses operator-controlled migrations. Startup performs only a
# read-only check and refuses to continue while migrations are pending.
DJANGO_AUTO_MIGRATE=0

DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=241172480
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

DB_NAME=classifieds_db
DB_USER=classifieds_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=5432

POSTGRES_DB=classifieds_db
POSTGRES_USER=classifieds_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
