# Production environment example for classifieds_local.
# Copy this file to your real production .env file and replace every CHANGE_ME value.
# Never commit real production secrets.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Use 1 when production traffic is served over HTTPS.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1

# Enable HSTS only after HTTPS is confirmed working.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1

# Set to 1 only when you are ready for browser preload-list requirements.
DJANGO_SECURE_HSTS_PRELOAD=0

DJANGO_LOG_LEVEL=INFO

# Database used by Django.
DB_NAME=classifieds_db
DB_USER=classifieds_user
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_DATABASE_PASSWORD
DB_HOST=db
DB_PORT=5432

# Database initialization used by the postgres container.
POSTGRES_DB=classifieds_db
POSTGRES_USER=classifieds_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_DATABASE_PASSWORD

# Current upload room for appeal evidence.
# Keep nginx client_max_body_size in sync.
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=241172480
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
