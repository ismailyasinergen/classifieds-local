# Production environment example for classifieds_local

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Use 1 when production traffic is served over HTTPS.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1

# Enable after HTTPS is confirmed working.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=0

DJANGO_LOG_LEVEL=INFO

# Current upload room for appeal evidence.
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=241172480
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
